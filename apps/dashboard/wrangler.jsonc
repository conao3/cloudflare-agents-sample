{
  "name": "cfas-dashboard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"],
  },
  "services": [
    { "binding": "STATE_COUNTER", "service": "cfas-state-counter" },
    { "binding": "SCHEDULER", "service": "cfas-scheduler" },
  ],
}
