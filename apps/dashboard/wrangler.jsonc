{
  "name": "cfas-dashboard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*",
      "/mcp",
      "/mcp/*",
      "/hub/*",
      "/oauth-mcp/*",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-protected-resource/*",
      "/elicit/*",
      "/x402/*",
    ],
  },
  "services": [
    { "binding": "STATE_COUNTER", "service": "cfas-state-counter" },
    { "binding": "SCHEDULER", "service": "cfas-scheduler" },
    { "binding": "CHAT", "service": "cfas-chat" },
    { "binding": "MCP_SERVER", "service": "cfas-mcp-server" },
    { "binding": "MCP_CLIENT", "service": "cfas-mcp-client" },
    { "binding": "MCP_OAUTH", "service": "cfas-mcp-oauth" },
    { "binding": "MCP_ELICITATION", "service": "cfas-mcp-elicitation" },
    { "binding": "X402", "service": "cfas-x402" },
    { "binding": "WORKFLOW", "service": "cfas-workflow" },
    { "binding": "BROWSER", "service": "cfas-browser" },
    { "binding": "EMAIL", "service": "cfas-email" },
    { "binding": "RAG", "service": "cfas-rag" },
    { "binding": "CODEMODE", "service": "cfas-codemode" },
    { "binding": "THINK", "service": "cfas-think" },
    { "binding": "SUB_AGENTS", "service": "cfas-sub-agents" },
    { "binding": "VOICE", "service": "cfas-voice" },
    { "binding": "RESEARCH", "service": "cfas-research" },
    { "binding": "INBOX", "service": "cfas-inbox" },
    { "binding": "TOOL_HUB", "service": "cfas-tool-hub" },
  ],
  "env": {
    "production": {
      "name": "cfas-dashboard",
      "services": [
        { "binding": "STATE_COUNTER", "service": "cfas-state-counter" },
        { "binding": "SCHEDULER", "service": "cfas-scheduler" },
        { "binding": "CHAT", "service": "cfas-chat" },
        { "binding": "MCP_SERVER", "service": "cfas-mcp-server" },
        { "binding": "MCP_CLIENT", "service": "cfas-mcp-client" },
        { "binding": "MCP_OAUTH", "service": "cfas-mcp-oauth" },
        { "binding": "MCP_ELICITATION", "service": "cfas-mcp-elicitation" },
        { "binding": "X402", "service": "cfas-x402" },
        { "binding": "WORKFLOW", "service": "cfas-workflow" },
        { "binding": "BROWSER", "service": "cfas-browser" },
        { "binding": "EMAIL", "service": "cfas-email" },
        { "binding": "RAG", "service": "cfas-rag" },
        { "binding": "THINK", "service": "cfas-think" },
        { "binding": "SUB_AGENTS", "service": "cfas-sub-agents" },
        { "binding": "VOICE", "service": "cfas-voice" },
        { "binding": "RESEARCH", "service": "cfas-research" },
        { "binding": "INBOX", "service": "cfas-inbox" },
        { "binding": "TOOL_HUB", "service": "cfas-tool-hub" },
      ],
    },
  },
}
