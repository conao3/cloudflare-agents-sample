{
  "name": "cfas-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "cfas-rag", "remote": true }],
  "durable_objects": {
    "bindings": [{ "name": "InboxAgent", "class_name": "InboxAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxAgent"] }],
}
