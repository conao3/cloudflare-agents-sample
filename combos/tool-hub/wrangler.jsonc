{
  "name": "cfas-tool-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "browser": { "binding": "BROWSER", "remote": true },
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "cfas-rag", "remote": true }],
}
