{
  "name": "cfas-github-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "RepoAgent", "class_name": "RepoAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoAgent"] }],
  "secrets": {
    "required": ["GITHUB_WEBHOOK_SECRET"],
  },
}
