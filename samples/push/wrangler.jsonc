{
  "name": "cfas-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "PushAgent", "class_name": "PushAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PushAgent"] }],
  "secrets": {
    "required": ["VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "VAPID_SUBJECT"],
  },
}
