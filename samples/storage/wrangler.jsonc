{
  "name": "cfas-storage",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [{ "binding": "DB", "database_name": "cfas-storage" }],
  "kv_namespaces": [{ "binding": "KV" }],
  "durable_objects": {
    "bindings": [{ "name": "StorageAgent", "class_name": "StorageAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StorageAgent"] }],
}
