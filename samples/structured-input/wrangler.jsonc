{
  "name": "cfas-structured-input",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "StructuredInputAgent", "class_name": "StructuredInputAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StructuredInputAgent"] }],
}
