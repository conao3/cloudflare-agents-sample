{
  "name": "cfas-workflow",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "WorkflowAgent", "class_name": "WorkflowAgent" }],
  },
  "workflows": [
    {
      "name": "cfas-approval-workflow",
      "binding": "APPROVAL_WORKFLOW",
      "class_name": "ApprovalWorkflow",
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkflowAgent"] }],
}
